{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@rs-react/*": ["src/*"],
      "@rs-react/components": ["src/components/index.ts"],
      "@rs-react/components/*": ["src/components/*"],
      "@rs-react/hooks": ["src/hooks/index.ts"],
      "@rs-react/store": ["src/store/index.ts"],
      "@rs-react/interfaces": ["src/interfaces/index.ts"],
      "@rs-react/constants": ["src/constants/index.ts"],
      "@rs-react/context": ["src/context/index.ts"],
      "@rs-react/assets/*": ["src/assets/*"]
    }
  },
  "include": [
    "./dist/types/**/*.ts",
    "./next-env.d.ts",
    "./src",
    ".next/types/**/*.ts",
    "./global.d.ts"
  ],
  "exclude": ["node_modules"]
}
